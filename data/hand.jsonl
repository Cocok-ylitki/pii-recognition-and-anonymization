{"id": "hand-001", "source": "hand", "text": "Я, Анна Ветрова, направила заявление.", "spans": [["NAME", 3, 7], ["SURNAME", 8, 15]]}
{"id": "hand-002", "source": "hand", "text": "Ответ отправили Алексею Грачёву на следующий день.", "spans": [["NAME", 16, 23], ["SURNAME", 24, 31]]}
{"id": "hand-003", "source": "hand", "text": "В приёмную пришли Лидия Крылова и Тимур Аскаров.", "spans": [["NAME", 18, 23], ["SURNAME", 24, 31], ["NAME", 34, 39], ["SURNAME", 40, 47]]}
{"id": "hand-004", "source": "hand", "text": "Карточку заполнила Анна-Мария Витт.", "spans": [["NAME", 19, 29], ["SURNAME", 30, 34]]}
{"id": "hand-005", "source": "hand", "text": "Договор отдали Льву Тихому.", "spans": [["NAME", 15, 19], ["SURNAME", 20, 26]]}
{"id": "hand-006", "source": "hand", "text": "В архив пришло письмо на имя Эммы Король.", "spans": [["NAME", 29, 33], ["SURNAME", 34, 40]]}
{"id": "hand-007", "source": "hand", "text": "Вера в успех помогла команде закончить работу.", "spans": []}
{"id": "hand-008", "source": "hand", "text": "Маргарита на витрине — название пиццы.", "spans": []}
{"id": "hand-009", "source": "hand", "text": "Сокол сел на ограду; счёт матча 3:02.", "spans": []}
{"id": "hand-010", "source": "hand", "text": "Входящий номер пакета 45 08 761200 относится к архивной накладной.", "spans": []}
{"id": "hand-011", "source": "hand", "text": "В каталоге упомянули компанию Mail.Ru Group.", "spans": []}
{"id": "hand-012", "source": "hand", "text": "Кадровик сверил паспорт 4517000894 и СНИЛС 112-233-445 95.", "spans": [["PASSPORT", 24, 34], ["SNILS", 43, 57]]}
{"id": "hand-013", "source": "hand", "text": "Паспорт 45 17 № 000894 предъявила Анна Ветрова.", "spans": [["PASSPORT", 8, 22], ["NAME", 34, 38], ["SURNAME", 39, 46]]}
{"id": "hand-014", "source": "hand", "text": "ИНН 502712857787; телефон +7 (812) 000-00-01.", "spans": [["INN", 4, 16], ["PHONE", 26, 44]]}
{"id": "hand-015", "source": "hand", "text": "Карта 4111 1111 1111 1111; ИНН 7707083893.", "spans": [["CARD", 6, 25], ["INN", 31, 41]]}
{"id": "hand-016", "source": "hand", "text": "На сайте https://portal.example/client/4111111111111111 есть инструкция.", "spans": [["URL", 9, 55]]}
{"id": "hand-017", "source": "hand", "text": "Проверьте свидетельство о браке IV-МР № 001894 и кадастровый номер 50:09:0070611:917.", "spans": [["MARRIAGE", 32, 46], ["CADASTRAL", 67, 84]]}
{"id": "hand-018", "source": "hand", "text": "На бланке заполнены поля: III-МК № 091777, экземпляр 2.", "spans": [["MARRIAGE", 26, 41]]}
{"id": "hand-019", "source": "hand", "text": "Проверьте паспорт 45 17\n000894 и подпись.", "spans": [["PASSPORT", 18, 30]]}
{"id": "hand-020", "source": "hand", "text": "Сведения актуальны на 09.10.2026, интервал 16:30–17:45.", "spans": []}
{"id": "hand-021", "source": "hand", "text": "Материалы доступны (https://docs.example/page_(test)).", "spans": [["URL", 20, 52]]}
{"id": "hand-022", "source": "hand", "text": "Тел. (495) 000-32-19. Сверьте также СНИЛС 11223344595.", "spans": [["PHONE", 5, 20], ["SNILS", 42, 53]]}
{"id": "hand-023", "source": "hand", "text": "Телефон 4950003219, резервный +7-812-000-00-01.", "spans": [["PHONE", 8, 18], ["PHONE", 30, 46]]}
{"id": "hand-024", "source": "hand", "text": "Для оплаты укажите карту 3782 822463 10005.", "spans": [["CARD", 25, 42]]}
{"id": "hand-025", "source": "hand", "text": "По кадастровому номеру 77:01:123:456 нашли участок.", "spans": [["CADASTRAL", 23, 36]]}
{"id": "hand-026", "source": "hand", "text": "В выписке в строке «Объект» значится 77:01:123:457.", "spans": [["CADASTRAL", 37, 50]]}
{"id": "hand-027", "source": "hand", "text": "Пожалуйста, напишите Саше Ким.", "spans": [["NAME", 21, 25], ["SURNAME", 26, 29]]}
{"id": "hand-028", "source": "hand", "text": "Подпись: Алимова Гульнара.", "spans": [["SURNAME", 9, 16], ["NAME", 17, 25]]}
{"id": "hand-029", "source": "hand", "text": "Протокол ftp://archive.example:2121/inbox сохранили.", "spans": [["URL", 9, 41]]}
